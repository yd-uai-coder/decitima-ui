# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sqlite (local dev/test database files, not the drizzle/ migrations themselves)
*.db
*.db-journal
*.db-wal
*.db-shm

# claude code (local-only agent permission settings; team-shared config would use settings.json instead)
.claude/settings.local.json

# editors
.vscode/
.idea/
*.swp

# os
Thumbs.db
