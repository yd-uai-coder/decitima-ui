  "views": {
    "shop_monthly_order_summary": {
      "columns": {
        "年月": {
          "name": "年月",
          "type": "text",
          "primaryKey": false,
          "notNull": true,
          "autoincrement": false
        },
        "受注件数": {
          "name": "受注件数",
          "type": "integer",
          "primaryKey": false,
          "notNull": true,
          "autoincrement": false
        },
        "売上額": {
          "name": "売上額",
          "type": "integer",
          "primaryKey": false,
          "notNull": true,
          "autoincrement": false
        },
        "トップス": {
          "name": "トップス",
          "type": "integer",
          "primaryKey": false,
          "notNull": true,
          "autoincrement": false
        },
        "ボトムス": {
          "name": "ボトムス",
          "type": "integer",
          "primaryKey": false,
          "notNull": true,
          "autoincrement": false
        },
        "シューズ": {
          "name": "シューズ",
          "type": "integer",
          "primaryKey": false,
          "notNull": true,
          "autoincrement": false
        },
        "バッグ": {
          "name": "バッグ",
          "type": "integer",
          "primaryKey": false,
          "notNull": true,
          "autoincrement": false
        }
      },
      "name": "shop_monthly_order_summary",
      "isExisting": false,
      "definition": "\n  select\n    strftime('%Y-%m', \"shop_orders\".\"order_date\") as \"年月\",\n    count(*) as \"受注件数\",\n    sum(\"shop_products\".\"price\") as \"売上額\",\n    sum(case when \"shop_categories\".\"name\" = 'tops' then 1 else 0 end) as \"トップス\",\n    sum(case when \"shop_categories\".\"name\" = 'bottoms' then 1 else 0 end) as \"ボトムス\",\n    sum(case when \"shop_categories\".\"name\" = 'shoes' then 1 else 0 end) as \"シューズ\",\n    sum(case when \"shop_categories\".\"name\" = 'bag' then 1 else 0 end) as \"バッグ\"\n  from \"shop_orders\"\n  inner join \"shop_products\" on \"shop_orders\".\"product_id\" = \"shop_products\".\"id\"\n  inner join \"shop_categories\" on \"shop_products\".\"category_id\" = \"shop_categories\".\"id\"\n  group by strftime('%Y-%m', \"shop_orders\".\"order_date\")\n  order by strftime('%Y-%m', \"shop_orders\".\"order_date\")\n"
    },
